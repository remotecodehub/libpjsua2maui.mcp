<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformCommandLineArguments>--report-trx --report-trx-filename test-results.trx --coverlet --coverlet-output-format cobertura</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <!-- Quality Gate -->
  <PropertyGroup>
    <QualityGateThreshold>90</QualityGateThreshold>
    <QualityGateResultsDirectory>$(MSBuildProjectDirectory)/TestResults/QualityGate</QualityGateResultsDirectory>
    <QualityGateReportDirectory>$(QualityGateResultsDirectory)/Report</QualityGateReportDirectory>
    <QualityGateMarkdownReport>$(QualityGateReportDirectory)/Summary.md</QualityGateMarkdownReport>
    <QualityGateTextReport>$(QualityGateReportDirectory)/Summary.txt</QualityGateTextReport>
    <QualityGateCoveragePattern>$(QualityGateResultsDirectory)/coverage.cobertura.*.xml</QualityGateCoveragePattern>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <AssemblyMetadata Include="RepositoryRoot" Value="$(MSBuildProjectDirectory)/../.." />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\libpjsua2maui.mcp.stdio\libpjsua2maui.mcp.stdio.csproj" />
    <ProjectReference Include="..\..\src\libpjsua2maui.mcp.http\libpjsua2maui.mcp.http.csproj" />
    <ProjectReference Include="..\..\src\libpjsua2maui.mcp\libpjsua2maui.mcp.csproj" />
  </ItemGroup>

  <Target Name="QualityGate" DependsOnTargets="Build">
    <Message Importance="High" Text="============================================================" />
    <Message Importance="High" Text="libpjsua2maui.mcp Unit Test Quality Gate (en-US)" />
    <Message Importance="High" Text="============================================================" />
    <Message Importance="High" Text="Running unit tests with code coverage..." />

    <RemoveDir Directories="$(QualityGateResultsDirectory)" />
    <MakeDir Directories="$(QualityGateResultsDirectory)" />

    <Exec Command="dotnet test &quot;$(MSBuildProjectFullPath)&quot; --configuration &quot;$(Configuration)&quot; --results-directory &quot;$(QualityGateResultsDirectory)&quot;" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="QualityGateTestExitCode" />
    </Exec>

    <Error Condition="'$(QualityGateTestExitCode)' != '0'" Text="Quality Gate aborted: unit tests failed with exit code $(QualityGateTestExitCode)." />

    <Exec Command="dotnet tool run reportgenerator -reports:&quot;$(QualityGateCoveragePattern)&quot; -targetdir:&quot;$(QualityGateReportDirectory)&quot; -reporttypes:&quot;MarkdownSummary;TextSummary&quot; -classfilters:&quot;+libpjsua2maui.mcp*;-Program&quot; -minimumCoverageThresholds:lineCoverage=$(QualityGateThreshold) -minimumCoverageThresholds:branchCoverage=$(QualityGateThreshold)" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="QualityGateReportGeneratorExitCode" />
    </Exec>

    <Error Condition="'$(QualityGateReportGeneratorExitCode)' != '0' and !Exists('$(QualityGateMarkdownReport)')" Text="Quality Gate aborted: ReportGenerator failed with exit code $(QualityGateReportGeneratorExitCode) and did not produce the Markdown report." />

    <Error Condition="!Exists('$(QualityGateMarkdownReport)')" Text="Quality Gate aborted: Markdown coverage report was not found at $(QualityGateMarkdownReport)." />

    <Error Condition="!Exists('$(QualityGateTextReport)')" Text="Quality Gate aborted: Text coverage report was not found at $(QualityGateTextReport)." />

    <PropertyGroup>
      <QualityGateTextContent>$([System.IO.File]::ReadAllText('$(QualityGateTextReport)'))</QualityGateTextContent>
      <QualityGateLineCoverage>$([System.Text.RegularExpressions.Regex]::Match($(QualityGateTextContent), '(?im)^\s*Line coverage:\s*([0-9]+(?:\.[0-9]+)?)%').Groups[1].Value)</QualityGateLineCoverage>
      <QualityGateMethodCoverage>$([System.Text.RegularExpressions.Regex]::Match($(QualityGateTextContent), '(?im)^\s*Method coverage:\s*([0-9]+(?:\.[0-9]+)?)%').Groups[1].Value)</QualityGateMethodCoverage>
      <QualityGateBranchCoverage>$([System.Text.RegularExpressions.Regex]::Match($(QualityGateTextContent), '(?im)^\s*Branch coverage:\s*([0-9]+(?:\.[0-9]+)?)%').Groups[1].Value)</QualityGateBranchCoverage>
      <QualityGateCoveredBranches>$([System.Text.RegularExpressions.Regex]::Match($(QualityGateTextContent), '(?im)^\s*Covered branches:\s*([0-9]+)').Groups[1].Value)</QualityGateCoveredBranches>
      <QualityGateTotalBranches>$([System.Text.RegularExpressions.Regex]::Match($(QualityGateTextContent), '(?im)^\s*Total branches:\s*([0-9]+)').Groups[1].Value)</QualityGateTotalBranches>
      <QualityGateHasBranchCoverage>$([System.Text.RegularExpressions.Regex]::IsMatch($(QualityGateTextContent), '(?im)^\s*Branch coverage:\s*[0-9]+(?:\.[0-9]+)?%'))</QualityGateHasBranchCoverage>
    </PropertyGroup>

    <Error Condition="'$(QualityGateLineCoverage)' == '' or '$(QualityGateMethodCoverage)' == '' or '$(QualityGateCoveredBranches)' == '' or '$(QualityGateTotalBranches)' == ''" Text="Quality Gate aborted: unable to extract line, branch and method coverage data from $(QualityGateTextReport)." />

    <PropertyGroup Condition="'$(QualityGateBranchCoverage)' == '' and '$(QualityGateTotalBranches)' == '0'">
      <QualityGateBranchCoverage>100</QualityGateBranchCoverage>
    </PropertyGroup>

    <PropertyGroup Condition="'$(QualityGateBranchCoverage)' == '' and '$(QualityGateTotalBranches)' != '0'">
      <QualityGateBranchCoverage>$([System.Math]::Round($([System.Double]::Parse('$(QualityGateCoveredBranches)')) * 100 / $([System.Double]::Parse('$(QualityGateTotalBranches)')), 1))</QualityGateBranchCoverage>
    </PropertyGroup>

    <Error Condition="'$(QualityGateBranchCoverage)' == ''" Text="Quality Gate aborted: unable to calculate branch coverage from Covered branches and Total branches in $(QualityGateTextReport)." />

    <WriteLinesToFile File="$(QualityGateTextReport)" Lines="  Branch coverage: $(QualityGateBranchCoverage)%" Overwrite="false" Encoding="UTF-8" Condition="'$(QualityGateHasBranchCoverage)' != 'True'" />

    <PropertyGroup>
      <QualityGateLineFailed Condition="'$(QualityGateLineCoverage)' &lt; '$(QualityGateThreshold)'">true</QualityGateLineFailed>
      <QualityGateBranchFailed Condition="'$(QualityGateBranchCoverage)' &lt; '$(QualityGateThreshold)'">true</QualityGateBranchFailed>
      <QualityGateMethodFailed Condition="'$(QualityGateMethodCoverage)' &lt; '$(QualityGateThreshold)'">true</QualityGateMethodFailed>
    </PropertyGroup>

    <Warning Code="QG001" Text="Line coverage below threshold: $(QualityGateLineCoverage)% &lt; $(QualityGateThreshold)%." Condition="'$(QualityGateLineFailed)' == 'true'" />

    <Warning Code="QG002" Text="Branch coverage below threshold: $(QualityGateBranchCoverage)% &lt; $(QualityGateThreshold)%." Condition="'$(QualityGateBranchFailed)' == 'true'" />

    <Warning Code="QG003" Text="Method coverage below threshold: $(QualityGateMethodCoverage)% &lt; $(QualityGateThreshold)%." Condition="'$(QualityGateMethodFailed)' == 'true'" />

    <PropertyGroup>
      <QualityGateFailureCount>0</QualityGateFailureCount>
      <QualityGateFailureCount Condition="'$(QualityGateLineFailed)' == 'true'">1</QualityGateFailureCount>
      <QualityGateFailureCount Condition="'$(QualityGateBranchFailed)' == 'true' and '$(QualityGateLineFailed)' == 'true'">2</QualityGateFailureCount>
      <QualityGateFailureCount Condition="'$(QualityGateMethodFailed)' == 'true' and '$(QualityGateLineFailed)' == 'true' and '$(QualityGateBranchFailed)' == 'true'">3</QualityGateFailureCount>
      <QualityGateFailureCount Condition="'$(QualityGateMethodFailed)' == 'true' and '$(QualityGateLineFailed)' == 'true' and '$(QualityGateBranchFailed)' != 'true'">2</QualityGateFailureCount>
      <QualityGateFailureCount Condition="'$(QualityGateMethodFailed)' == 'true' and '$(QualityGateLineFailed)' != 'true' and '$(QualityGateBranchFailed)' == 'true'">2</QualityGateFailureCount>
      <QualityGateFailureCount Condition="'$(QualityGateMethodFailed)' == 'true' and '$(QualityGateLineFailed)' != 'true' and '$(QualityGateBranchFailed)' != 'true'">1</QualityGateFailureCount>
    </PropertyGroup>

    <PropertyGroup>
      <QualityGateFailureSummary Condition="'$(QualityGateFailureCount)' == '1' and '$(QualityGateLineFailed)' == 'true'">Line coverage $(QualityGateLineCoverage)% is below the required $(QualityGateThreshold)%.</QualityGateFailureSummary>
      <QualityGateFailureSummary Condition="'$(QualityGateFailureCount)' == '1' and '$(QualityGateBranchFailed)' == 'true'">Branch coverage $(QualityGateBranchCoverage)% is below the required $(QualityGateThreshold)%.</QualityGateFailureSummary>
      <QualityGateFailureSummary Condition="'$(QualityGateFailureCount)' == '1' and '$(QualityGateMethodFailed)' == 'true'">Method coverage $(QualityGateMethodCoverage)% is below the required $(QualityGateThreshold)%.</QualityGateFailureSummary>
      <QualityGateFailureSummary Condition="'$(QualityGateFailureCount)' == '2' and '$(QualityGateLineFailed)' == 'true' and '$(QualityGateBranchFailed)' == 'true'">Line coverage $(QualityGateLineCoverage)% and branch coverage $(QualityGateBranchCoverage)% are below the required $(QualityGateThreshold)%.</QualityGateFailureSummary>
      <QualityGateFailureSummary Condition="'$(QualityGateFailureCount)' == '2' and '$(QualityGateLineFailed)' == 'true' and '$(QualityGateMethodFailed)' == 'true'">Line coverage $(QualityGateLineCoverage)% and method coverage $(QualityGateMethodCoverage)% are below the required $(QualityGateThreshold)%.</QualityGateFailureSummary>
      <QualityGateFailureSummary Condition="'$(QualityGateFailureCount)' == '2' and '$(QualityGateBranchFailed)' == 'true' and '$(QualityGateMethodFailed)' == 'true'">Branch coverage $(QualityGateBranchCoverage)% and method coverage $(QualityGateMethodCoverage)% are below the required $(QualityGateThreshold)%.</QualityGateFailureSummary>
      <QualityGateFailureSummary Condition="'$(QualityGateFailureCount)' == '3'">Line coverage $(QualityGateLineCoverage)%, branch coverage $(QualityGateBranchCoverage)% and method coverage $(QualityGateMethodCoverage)% are below the required $(QualityGateThreshold)%.</QualityGateFailureSummary>
    </PropertyGroup>

    <Message Importance="High" Text="Line Coverage:    $(QualityGateLineCoverage)% [PASSED]" Condition="'$(QualityGateFailureCount)' == '0' and '$(QualityGateReportGeneratorExitCode)' == '0'" />

    <Message Importance="High" Text="Branch Coverage:  $(QualityGateBranchCoverage)% [PASSED]" Condition="'$(QualityGateFailureCount)' == '0' and '$(QualityGateReportGeneratorExitCode)' == '0'" />

    <Message Importance="High" Text="Method Coverage:  $(QualityGateMethodCoverage)% [PASSED]" Condition="'$(QualityGateFailureCount)' == '0' and '$(QualityGateReportGeneratorExitCode)' == '0'" />

    <Message Importance="High" Text="Required:         $(QualityGateThreshold).00%" Condition="'$(QualityGateFailureCount)' == '0' and '$(QualityGateReportGeneratorExitCode)' == '0'" />

    <Message Importance="High" Text="QUALITY GATE: PASSED" Condition="'$(QualityGateFailureCount)' == '0' and '$(QualityGateReportGeneratorExitCode)' == '0'" />

    <Error Condition="'$(QualityGateFailureCount)' != '0'" Text="Quality Gate failed: $(QualityGateFailureSummary)" />

    <Error Condition="'$(QualityGateFailureCount)' == '0' and '$(QualityGateReportGeneratorExitCode)' != '0'" Text="Quality Gate failed: ReportGenerator exited with code $(QualityGateReportGeneratorExitCode)." />

    <Message Importance="High" Text="============================================================" />

  </Target>

  <!--
    Runs the already-built Microsoft.Testing.Platform executable directly.
    Use this target when the project-level QualityGate target cannot be invoked
    in the local environment. It preserves the same configured threshold and
    validates line, branch, and method coverage from the generated report.
  -->
  <Target Name="QualityGateExecutable" DependsOnTargets="Build">
    <Message Importance="High" Text="============================================================" />
    <Message Importance="High" Text="libpjsua2maui.mcp Executable Quality Gate (en-US)" />
    <Message Importance="High" Text="============================================================" />

    <RemoveDir Directories="$(QualityGateResultsDirectory)" />
    <MakeDir Directories="$(QualityGateResultsDirectory)" />

    <Exec Command="&quot;$(TargetPath)&quot; --report-trx --report-trx-filename test-results.trx --coverlet --coverlet-output-format cobertura"
          WorkingDirectory="$(QualityGateResultsDirectory)"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="QualityGateExecutableTestExitCode" />
    </Exec>

    <Error Condition="'$(QualityGateExecutableTestExitCode)' != '0'"
           Text="Executable Quality Gate aborted: tests failed with exit code $(QualityGateExecutableTestExitCode)." />

    <Exec Command="dotnet tool run reportgenerator -reports:&quot;$(QualityGateCoveragePattern)&quot; -targetdir:&quot;$(QualityGateReportDirectory)&quot; -reporttypes:&quot;MarkdownSummary;TextSummary&quot; -classfilters:&quot;+libpjsua2maui.mcp*;-Program&quot;"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="QualityGateExecutableReportGeneratorExitCode" />
    </Exec>

    <Error Condition="'$(QualityGateExecutableReportGeneratorExitCode)' != '0'"
           Text="Executable Quality Gate aborted: ReportGenerator failed with exit code $(QualityGateExecutableReportGeneratorExitCode)." />
    <Error Condition="!Exists('$(QualityGateMarkdownReport)')"
           Text="Executable Quality Gate aborted: Markdown coverage report was not found at $(QualityGateMarkdownReport)." />
    <Error Condition="!Exists('$(QualityGateTextReport)')"
           Text="Executable Quality Gate aborted: text coverage report was not found at $(QualityGateTextReport)." />

    <PropertyGroup>
      <QualityGateExecutableTextContent>$([System.IO.File]::ReadAllText('$(QualityGateTextReport)'))</QualityGateExecutableTextContent>
      <QualityGateExecutableLineCoverage>$([System.Text.RegularExpressions.Regex]::Match($(QualityGateExecutableTextContent), '(?im)^\s*Line coverage:\s*([0-9]+(?:\.[0-9]+)?)%').Groups[1].Value)</QualityGateExecutableLineCoverage>
      <QualityGateExecutableMethodCoverage>$([System.Text.RegularExpressions.Regex]::Match($(QualityGateExecutableTextContent), '(?im)^\s*Method coverage:\s*([0-9]+(?:\.[0-9]+)?)%').Groups[1].Value)</QualityGateExecutableMethodCoverage>
      <QualityGateExecutableBranchCoverage>$([System.Text.RegularExpressions.Regex]::Match($(QualityGateExecutableTextContent), '(?im)^\s*Branch coverage:\s*([0-9]+(?:\.[0-9]+)?)%').Groups[1].Value)</QualityGateExecutableBranchCoverage>
      <QualityGateExecutableCoveredBranches>$([System.Text.RegularExpressions.Regex]::Match($(QualityGateExecutableTextContent), '(?im)^\s*Covered branches:\s*([0-9]+)').Groups[1].Value)</QualityGateExecutableCoveredBranches>
      <QualityGateExecutableTotalBranches>$([System.Text.RegularExpressions.Regex]::Match($(QualityGateExecutableTextContent), '(?im)^\s*Total branches:\s*([0-9]+)').Groups[1].Value)</QualityGateExecutableTotalBranches>
    </PropertyGroup>

    <Error Condition="'$(QualityGateExecutableLineCoverage)' == '' or '$(QualityGateExecutableMethodCoverage)' == '' or '$(QualityGateExecutableCoveredBranches)' == '' or '$(QualityGateExecutableTotalBranches)' == ''"
           Text="Executable Quality Gate aborted: unable to extract line, method, or branch coverage data from $(QualityGateTextReport)." />

    <PropertyGroup Condition="'$(QualityGateExecutableBranchCoverage)' == '' and '$(QualityGateExecutableTotalBranches)' == '0'">
      <QualityGateExecutableBranchCoverage>100</QualityGateExecutableBranchCoverage>
    </PropertyGroup>
    <PropertyGroup Condition="'$(QualityGateExecutableBranchCoverage)' == '' and '$(QualityGateExecutableTotalBranches)' != '0'">
      <QualityGateExecutableBranchCoverage>$([System.Math]::Round($([System.Double]::Parse('$(QualityGateExecutableCoveredBranches)')) * 100 / $([System.Double]::Parse('$(QualityGateExecutableTotalBranches)')), 1))</QualityGateExecutableBranchCoverage>
    </PropertyGroup>
    <Error Condition="'$(QualityGateExecutableBranchCoverage)' == ''"
           Text="Executable Quality Gate aborted: unable to calculate branch coverage." />

    <PropertyGroup>
      <QualityGateExecutableLineFailed Condition="'$(QualityGateExecutableLineCoverage)' &lt; '$(QualityGateThreshold)'">true</QualityGateExecutableLineFailed>
      <QualityGateExecutableBranchFailed Condition="'$(QualityGateExecutableBranchCoverage)' &lt; '$(QualityGateThreshold)'">true</QualityGateExecutableBranchFailed>
      <QualityGateExecutableMethodFailed Condition="'$(QualityGateExecutableMethodCoverage)' &lt; '$(QualityGateThreshold)'">true</QualityGateExecutableMethodFailed>
    </PropertyGroup>

    <Message Importance="High" Text="Line Coverage:    $(QualityGateExecutableLineCoverage)% $(if)" Condition="false" />
    <Message Importance="High" Text="Line Coverage:    $(QualityGateExecutableLineCoverage)% [$(QualityGateExecutableLineFailed)]" />
    <Message Importance="High" Text="Branch Coverage:  $(QualityGateExecutableBranchCoverage)% [$(QualityGateExecutableBranchFailed)]" />
    <Message Importance="High" Text="Method Coverage:  $(QualityGateExecutableMethodCoverage)% [$(QualityGateExecutableMethodFailed)]" />
    <Message Importance="High" Text="Required:         $(QualityGateThreshold)%" />

    <Error Condition="'$(QualityGateExecutableLineFailed)' == 'true' or '$(QualityGateExecutableBranchFailed)' == 'true' or '$(QualityGateExecutableMethodFailed)' == 'true'"
           Text="EXECUTABLE QUALITY GATE: FAILED. Required minimum is $(QualityGateThreshold)% for line, branch, and method coverage." />

    <Message Importance="High" Text="EXECUTABLE QUALITY GATE: PASSED" />
    <Message Importance="High" Text="Reports: $(QualityGateReportDirectory)" />
    <Message Importance="High" Text="============================================================" />
  </Target>

</Project>
